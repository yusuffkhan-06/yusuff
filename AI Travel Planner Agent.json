    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"summary\": \"Short overview of the trip\",\n  \"destination\": \"Goa\",\n  \"day_wise_plan\": [\n    {\n      \"day\": 1,\n      \"title\": \"Beaches and Forts\",\n      \"activities\": [\n        \"Morning: Baga Beach\",\n        \"Afternoon: Fort Aguada\"\n      ],\n      \"approx_cost\": 2500\n    }\n  ],\n  \"estimated_total_cost\": 9800,\n  \"budget_status\": \"Within budget\",\n  \"weather_note\": \"Sunny, 30C, low chance of rain\",\n  \"packing_tips\": [\n    \"Sunscreen\",\n    \"Light cotton clothes\"\n  ]\n}"
      },
      "id": "29312cab-fcd5-47bb-80e1-1605560b0087",
      "name": "Structured Output Parser",
