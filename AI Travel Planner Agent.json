    {
      "parameters": {
        "jsCode": "const f = $('On form submission').first().json;\nconst o = $json.output || $json;\nconst days = (o.day_wise_plan || []).map(d =>\n  `<h3>Day ${d.day}: ${d.title}</h3><ul>${(d.activities || []).map(a => `<li>${a}</li>`).join('')}</ul><p><b>Approx. cost:</b> &#8377;${d.approx_cost}</p>`\n).join('');\nconst tips = (o.packing_tips || []).map(t => `<li>${t}</li>`).join('');\nconst html = `<div style=\"font-family:Arial,sans-serif;max-width:640px\">\n<h2>Your Travel Plan: ${o.destination || f['Destination']}</h2>\n<p>Hi ${f['Name']},</p><p>${o.summary}</p>\n${days}\n<h3>Weather</h3><p>${o.weather_note}</p>\n<h3>Packing tips</h3><ul>${tips}</ul>\n<h3>Budget</h3><p>Estimated total: <b>&#8377;${o.estimated_total_cost}</b> (your budget: &#8377;${f['Budget (INR)']}) - ${o.budget_status}</p>\n<p>Happy travels!<br>- AI Travel Planner Agent</p></div>`;\nreturn [{ json: {\n  email: f['Email'], name: f['Name'], destination: o.destination || f['Destination'],\n  days: f['Number of Days'], budget: f['Budget (INR)'], total: o.estimated_total_cost,\n  budget_status: o.budget_status, summary: o.summary, html\n}}];"
      },
